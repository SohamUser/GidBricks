# Docker Compose reads these optional host port overrides from a root .env file.
FRONTEND_PORT=8000
BACKEND_PORT=8001

# Python API UK-local decision-time assumption; restart/recreate backend after changes.
# Standalone Python reads the process environment, not this file automatically.
DECISION_CUTOFF_LOCAL=09:50

# Vite development server only; Docker uses the internal backend service name.
VITE_API_PROXY_TARGET=http://127.0.0.1:8001
